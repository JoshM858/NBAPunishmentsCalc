# Copy to .env (git-ignored) for `npm start` and `npm run check`. Never commit the real one.

# The number after leagueId= in your ESPN league link
LEAGUE_ID=
# ESPN names NBA seasons by the year they end: 2026-27 is 2027
SEASON=2027
# Login cookies from fantasy.espn.com (skip both if the league is viewable to the public)
ESPN_S2=
ESPN_SWID=
# Optional: team IDs, abbreviations or names to leave off the board, comma-separated
HIDE_TEAMS=
# Optional: port for the local server (default 8787)
# PORT=8787
