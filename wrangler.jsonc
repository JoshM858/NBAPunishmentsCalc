{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantasy-punishment",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Number after leagueId= in your ESPN league URL
    "LEAGUE_ID": "823721722",
    // ESPN names NBA seasons by the year they end: 2026-27 = 2027
    "SEASON": "2027",
    // Optional: comma-separated team IDs, abbreviations or names to leave off the board
    "HIDE_TEAMS": "3",
    // Day your weeks start in US Eastern time (Tuesday: weeks run Tuesday to Monday)
    "WEEK_START": "Tuesday",
    // Time zone for game start and finish times (Victoria = Australia/Melbourne)
    "TIMEZONE": "Australia/Melbourne",
    // Seconds between refreshes for each signed-in team (or device); 0 turns the limit off
    "REFRESH_SECONDS": "5"
  }
  // Trade block (target lists, trading blocks): create a namespace with `npx wrangler kv namespace create BOARD`, then uncomment and paste its id:
  // "kv_namespaces": [{ "binding": "BOARD", "id": "PASTE-THE-ID-HERE" }],
  // Secrets: also TEAM_PINS (and optionally SESSION_SECRET) if you want a PIN per team, from `npm run pins`.
  // Secrets (never put these here, optional if the league is public): npx wrangler secret put ESPN_S2 / ESPN_SWID
}
