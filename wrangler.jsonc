{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantasy-punishment",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Number after leagueId= in your ESPN league URL
    "LEAGUE_ID": "",
    // ESPN names NBA seasons by the year they end: 2026-27 = 2027
    "SEASON": "2027",
    // Optional: comma-separated team IDs, abbreviations or names to leave off the board
    "HIDE_TEAMS": "",
    // Day your weeks start in US Eastern time (Tuesday: weeks run Tuesday to Monday)
    "WEEK_START": "Tuesday"
  }
  // Secrets (never put these here, optional if the league is public): npx wrangler secret put ESPN_S2 / ESPN_SWID
}
